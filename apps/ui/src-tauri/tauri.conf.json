{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "FidoRust",
	"version": "0.3.6",
	"identifier": "com.fidorust.app",
	"build": {
		"beforeDevCommand": "npm run dev:web",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "npm run wasm && npx vite build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "FidoRust",
				"width": 1280,
				"height": 800,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"fileAssociations": [
			{
				"ext": ["fcd"],
				"name": "FidoCAD Drawing",
				"description": "FidoCAD drawing",
				"role": "Editor",
				"mimeType": "application/x-fidocad"
			},
			{
				"ext": ["fcl"],
				"name": "FidoCAD Library",
				"description": "FidoCAD library",
				"role": "Editor",
				"mimeType": "application/x-fidocad-library"
			}
		]
	}
}
