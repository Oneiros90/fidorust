{
	"name": "fidorust",
	"private": true,
	"version": "0.3.9",
	"type": "module",
	"scripts": {
		"dev:web": "vite",
		"dev:desktop": "tauri dev",
		"build": "npx tauri build",
		"wasm": "wasm-pack build ../../crates/fidorust-wasm --target web --out-dir ../../apps/ui/src/wasm --out-name fidorust_wasm",
		"bump": "prettier --write . && node ../../tools/bump.mjs",
		"check": "npm run wasm && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "cargo test --workspace"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tauri-apps/cli": "^2.8.0",
		"prettier": "^3.6.0",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.38.0",
		"svelte-check": "^4.3.0",
		"typescript": "^5.9.0",
		"vite": "^6.3.0",
		"wasm-pack": "^0.15.0"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.8.0",
		"@tauri-apps/plugin-dialog": "^2.4.0",
		"@tauri-apps/plugin-fs": "^2.4.0",
		"@tauri-apps/plugin-opener": "^2.4.0",
		"svelte-awesome-color-picker": "^4.1.0"
	}
}
