/* tslint:disable */
/* eslint-disable */

export class App {
    free(): void;
    [Symbol.dispose](): void;
    add_layer(): void;
    apply_selection_props(patch_json: string): void;
    attach_canvas(canvas: HTMLCanvasElement): void;
    begin_selected_text_edit(): string;
    cancel_component_edit(): boolean;
    cancel_text_edit(): void;
    clear_hover(): void;
    clipboard_fcd(): string;
    commit_text_edit(text: string): void;
    component_cursor_json(name: string): string;
    component_preview_svg(name: string): string;
    create_component_from_selection(target: string, display_name: string): string;
    dblclick(sx: number, sy: number): string;
    delete_component(stem: string, key: string): boolean;
    /**
     * `mode` is `"objects"` (delete primitives) or `"move"` (relocate to `move_to`).
     */
    delete_layer(n: number, mode: string, move_to: number): void;
    edit_selected_component(): boolean;
    enter_component_edit(stem: string, key: string): boolean;
    /**
     * `opts_json` is `{ margin_lu, bw, layers: [{ show, invert }] }`. Empty / invalid JSON uses document layers.
     */
    export_svg(opts_json: string): string;
    fit(): void;
    invert_selection(): void;
    key(key: string, meta: boolean): boolean;
    layer_object_count(n: number): number;
    layers_json(): string;
    library_json(): string;
    load_fcd(text: string): void;
    load_fcd_bytes(bytes: Uint8Array): void;
    load_local_library(text: string): void;
    local_library_fcl(): string;
    mirror(): void;
    move_component(stem: string, key: string, dest_stem: string): string;
    constructor();
    new_doc(): void;
    paste_selection(text: string): void;
    place_component_at(name: string, sx: number, sy: number): void;
    pointer_down(sx: number, sy: number, shift: boolean, pan: boolean): void;
    pointer_move(sx: number, sy: number): void;
    pointer_right(sx: number, sy: number): boolean;
    pointer_up(sx: number, sy: number): void;
    prepare_context_menu(sx: number, sy: number): void;
    redo(): void;
    rename_component(stem: string, key: string, name: string): boolean;
    render(): void;
    reorder_layer(from: number, to: number): void;
    resize(w: number, h: number): void;
    rotate(): void;
    save_component_edit(): boolean;
    save_fcd(): string;
    /**
     * Like `save_fcd`, but expands components whose definition cannot be recovered from the file
     * when the “split non-standard components” option is on (local library, unresolved refs).
     */
    save_portable_fcd(): string;
    selection_props_form_json(): string;
    selection_props_json(): string;
    set_component_description(stem: string, key: string, description: string): boolean;
    set_filled(on: boolean): void;
    set_grid(x: number, y: number): void;
    set_hide_component_origin(on: boolean): void;
    set_layer(n: number): void;
    set_layer_color(n: number, r: number, g: number, b: number, a: number): void;
    set_layer_name(n: number, name: string): void;
    set_layer_show(n: number, show: boolean): void;
    set_locale(loc: string): void;
    set_pcb_mode(on: boolean): void;
    set_pending_component(name: string): void;
    set_pending_follow(on: boolean): void;
    set_pending_text(text: string): void;
    set_show_grid(on: boolean): void;
    set_snap(x: number, y: number): void;
    set_snap_enable(on: boolean): void;
    set_split_components(on: boolean): void;
    set_theme(theme: string): void;
    set_tool(id: string): void;
    set_track_width(w: number): void;
    set_view(zoom: number, pan_x: number, pan_y: number): void;
    split_selected_components(): void;
    status_json(): string;
    undo(): void;
    user_libraries_json(): string;
    wheel(sx: number, sy: number, delta: number): void;
    world_to_screen_json(wx: number, wy: number): string;
}

export type InitInput = RequestInfo | URL | Response | BufferSource | WebAssembly.Module;

export interface InitOutput {
    readonly memory: WebAssembly.Memory;
    readonly __wbg_app_free: (a: number, b: number) => void;
    readonly app_add_layer: (a: number) => void;
    readonly app_apply_selection_props: (a: number, b: number, c: number) => [number, number];
    readonly app_attach_canvas: (a: number, b: any) => [number, number];
    readonly app_begin_selected_text_edit: (a: number) => [number, number];
    readonly app_cancel_component_edit: (a: number) => number;
    readonly app_cancel_text_edit: (a: number) => void;
    readonly app_clear_hover: (a: number) => void;
    readonly app_clipboard_fcd: (a: number) => [number, number];
    readonly app_commit_text_edit: (a: number, b: number, c: number) => void;
    readonly app_component_cursor_json: (a: number, b: number, c: number) => [number, number];
    readonly app_component_preview_svg: (a: number, b: number, c: number) => [number, number];
    readonly app_create_component_from_selection: (a: number, b: number, c: number, d: number, e: number) => [number, number];
    readonly app_dblclick: (a: number, b: number, c: number) => [number, number];
    readonly app_delete_component: (a: number, b: number, c: number, d: number, e: number) => number;
    readonly app_delete_layer: (a: number, b: number, c: number, d: number, e: number) => void;
    readonly app_edit_selected_component: (a: number) => number;
    readonly app_enter_component_edit: (a: number, b: number, c: number, d: number, e: number) => number;
    readonly app_export_svg: (a: number, b: number, c: number) => [number, number];
    readonly app_fit: (a: number) => void;
    readonly app_invert_selection: (a: number) => void;
    readonly app_key: (a: number, b: number, c: number, d: number) => number;
    readonly app_layer_object_count: (a: number, b: number) => number;
    readonly app_layers_json: (a: number) => [number, number];
    readonly app_library_json: (a: number) => [number, number];
    readonly app_load_fcd: (a: number, b: number, c: number) => [number, number];
    readonly app_load_fcd_bytes: (a: number, b: number, c: number) => [number, number];
    readonly app_load_local_library: (a: number, b: number, c: number) => void;
    readonly app_local_library_fcl: (a: number) => [number, number];
    readonly app_mirror: (a: number) => void;
    readonly app_move_component: (a: number, b: number, c: number, d: number, e: number, f: number, g: number) => [number, number];
    readonly app_new: () => number;
    readonly app_new_doc: (a: number) => void;
    readonly app_paste_selection: (a: number, b: number, c: number) => void;
    readonly app_place_component_at: (a: number, b: number, c: number, d: number, e: number) => void;
    readonly app_pointer_down: (a: number, b: number, c: number, d: number, e: number) => void;
    readonly app_pointer_move: (a: number, b: number, c: number) => void;
    readonly app_pointer_right: (a: number, b: number, c: number) => number;
    readonly app_pointer_up: (a: number, b: number, c: number) => void;
    readonly app_prepare_context_menu: (a: number, b: number, c: number) => void;
    readonly app_redo: (a: number) => void;
    readonly app_rename_component: (a: number, b: number, c: number, d: number, e: number, f: number, g: number) => number;
    readonly app_render: (a: number) => void;
    readonly app_reorder_layer: (a: number, b: number, c: number) => void;
    readonly app_resize: (a: number, b: number, c: number) => void;
    readonly app_rotate: (a: number) => void;
    readonly app_save_component_edit: (a: number) => number;
    readonly app_save_fcd: (a: number) => [number, number];
    readonly app_save_portable_fcd: (a: number) => [number, number];
    readonly app_selection_props_form_json: (a: number) => [number, number];
    readonly app_selection_props_json: (a: number) => [number, number];
    readonly app_set_component_description: (a: number, b: number, c: number, d: number, e: number, f: number, g: number) => number;
    readonly app_set_filled: (a: number, b: number) => void;
    readonly app_set_grid: (a: number, b: number, c: number) => void;
    readonly app_set_hide_component_origin: (a: number, b: number) => void;
    readonly app_set_layer: (a: number, b: number) => void;
    readonly app_set_layer_color: (a: number, b: number, c: number, d: number, e: number, f: number) => void;
    readonly app_set_layer_name: (a: number, b: number, c: number, d: number) => void;
    readonly app_set_layer_show: (a: number, b: number, c: number) => void;
    readonly app_set_locale: (a: number, b: number, c: number) => void;
    readonly app_set_pcb_mode: (a: number, b: number) => void;
    readonly app_set_pending_component: (a: number, b: number, c: number) => void;
    readonly app_set_pending_follow: (a: number, b: number) => void;
    readonly app_set_pending_text: (a: number, b: number, c: number) => void;
    readonly app_set_show_grid: (a: number, b: number) => void;
    readonly app_set_snap: (a: number, b: number, c: number) => void;
    readonly app_set_snap_enable: (a: number, b: number) => void;
    readonly app_set_split_components: (a: number, b: number) => void;
    readonly app_set_theme: (a: number, b: number, c: number) => void;
    readonly app_set_tool: (a: number, b: number, c: number) => void;
    readonly app_set_track_width: (a: number, b: number) => void;
    readonly app_set_view: (a: number, b: number, c: number, d: number) => void;
    readonly app_split_selected_components: (a: number) => void;
    readonly app_status_json: (a: number) => [number, number];
    readonly app_undo: (a: number) => void;
    readonly app_user_libraries_json: (a: number) => [number, number];
    readonly app_wheel: (a: number, b: number, c: number, d: number) => void;
    readonly app_world_to_screen_json: (a: number, b: number, c: number) => [number, number];
    readonly __wbindgen_malloc: (a: number, b: number) => number;
    readonly __wbindgen_realloc: (a: number, b: number, c: number, d: number) => number;
    readonly __externref_table_alloc: () => number;
    readonly __wbindgen_externrefs: WebAssembly.Table;
    readonly __wbindgen_exn_store: (a: number) => void;
    readonly __externref_table_dealloc: (a: number) => void;
    readonly __wbindgen_free: (a: number, b: number, c: number) => void;
    readonly __wbindgen_start: () => void;
}

export type SyncInitInput = BufferSource | WebAssembly.Module;

/**
 * Instantiates the given `module`, which can either be bytes or
 * a precompiled `WebAssembly.Module`.
 *
 * @param {{ module: SyncInitInput }} module - Passing `SyncInitInput` directly is deprecated.
 *
 * @returns {InitOutput}
 */
export function initSync(module: { module: SyncInitInput } | SyncInitInput): InitOutput;

/**
 * If `module_or_path` is {RequestInfo} or {URL}, makes a request and
 * for everything else, calls `WebAssembly.instantiate` directly.
 *
 * @param {{ module_or_path: InitInput | Promise<InitInput> }} module_or_path - Passing `InitInput` directly is deprecated.
 *
 * @returns {Promise<InitOutput>}
 */
export default function __wbg_init (module_or_path?: { module_or_path: InitInput | Promise<InitInput> } | InitInput | Promise<InitInput>): Promise<InitOutput>;
